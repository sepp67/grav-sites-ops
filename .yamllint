---
# grav-sites-ops — configuration yamllint (lot L0, harnais de tests)
# Utilisee par GSO-T01 (make test-syntax) et par la CI.

extends: default

ignore: |
  roles/
  collections/
  .ansible/

rules:
  line-length:
    max: 160
    level: warning
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  document-start:
    present: true
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
